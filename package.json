{
  "name": "opencarls",
  "version": "0.1.0",
  "description": "OpenCarls — Daemon agéntico perpetuo, gateway y CLI (Bun + TypeScript). Estilo Claude Code / OpenClaw / Hermes Agent.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "daemon": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "tools": "bun run src/index.ts tools",
    "exec": "bun run src/index.ts exec",
    "smoke": "bun run scripts/smoke.ts",
    "test:diff": "bun run scripts/test-diff.ts",
    "typecheck": "tsc --noEmit",
    "gateway": "bun src/gateway/server.ts",
    "tui": "bun src/cli/tui.ts",
    "e2e": "bun scripts/e2e.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "@types/react": "^18.3.18",
    "typescript": "^5.7.2"
  }
}
